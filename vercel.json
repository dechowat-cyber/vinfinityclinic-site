{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.vinfinityclinic.com" }], "destination": "https://vinfinityclinic.com/$1", "permanent": true }
  ]
}
