# LINE Messaging API channel. ID + secret are shown in OA Manager > Settings > Messaging API.
# With ID + secret the app issues its own short-lived tokens; a long-lived token is optional.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OA_ID=@vinfinityclinic
# LINE Login channel — staff sign-in. LIFF only works if it is in the SAME provider as the
# Messaging API channel; leave NEXT_PUBLIC_LIFF_ID empty to use signed personal links instead.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
NEXT_PUBLIC_LIFF_ID=
# Postgres (Vercel > Storage > Neon creates this automatically)
DATABASE_URL=
# Long random strings
SESSION_SECRET=
CRON_SECRET=
# Public URL of this app, e.g. https://vinfinity-line.vercel.app
APP_URL=
# Conversion APIs (optional; each turns on when both values are set). Only clients with marketing consent are sent, hashed.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
